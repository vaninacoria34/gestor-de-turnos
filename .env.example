# ===== Configuración del entorno (gestor de turnos) =====
# Copiar este archivo a .env y ajustar los valores según el entorno.

JWT_SECRET=cambia-esta-clave-secreta
PORT=3000

# --- Email (opcional: sin SMTP los avisos van solo a consola/BD) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=mi_correo@gmail.com
# SMTP_PASS=contrasena_de_aplicacion
# SMTP_FROM=Gestor de Turnos <no-reply@empresa.com>

# --- WhatsApp (elige UNA opcion) ---
# Opcion A: CallMeBot (la mas facil) - guarda +34 644 66 32 62, mandale por WhatsApp 'I allow callmebot to send me messages' y te da una clave:
# CALLMEBOT_APIKEY=tu_clave_aqui
# Opcion B: WhatsApp Cloud API oficial de Meta (business.facebook.com):
# WHATSAPP_TOKEN=tu_token_de_meta
# WHATSAPP_PHONE_ID=id_de_tu_numero
